# 提取搜索结果
try:
    # 获取当前页面URL以确定搜索引擎类型
    current_url = page.url
    results = []
    
    if "baidu.com" in current_url:
        # 百度搜索结果
        result_elements = page.locator(".result, .c-container").all()
        for i, element in enumerate(result_elements[:10]):
            try:
                title_elem = element.locator("h3 a, .t a").first
                desc_elem = element.locator(".c-abstract, .c-span9").first
                
                title = title_elem.inner_text() if title_elem.count() > 0 else "无标题"
                description = desc_elem.inner_text() if desc_elem.count() > 0 else "无描述"
                href = title_elem.get_attribute("href") if title_elem.count() > 0 else ""
                
                results.append({
                    "title": title.strip(),
                    "description": description.strip()[:200],
                    "url": href,
                    "index": i + 1
                })
            except:
                continue
                
    elif "bing.com" in current_url:
        # 必应搜索结果
        result_elements = page.locator(".b_algo").all()
        for i, element in enumerate(result_elements[:10]):
            try:
                title_elem = element.locator("h2 a").first
                desc_elem = element.locator(".b_caption p").first
                
                title = title_elem.inner_text() if title_elem.count() > 0 else "无标题"
                description = desc_elem.inner_text() if desc_elem.count() > 0 else "无描述"
                href = title_elem.get_attribute("href") if title_elem.count() > 0 else ""
                
                results.append({
                    "title": title.strip(),
                    "description": description.strip()[:200],
                    "url": href,
                    "index": i + 1
                })
            except:
                continue
                
    elif "google.com" in current_url:
        # Google搜索结果
        result_elements = page.locator(".g").all()
        for i, element in enumerate(result_elements[:10]):
            try:
                title_elem = element.locator("h3").first
                desc_elem = element.locator(".VwiC3b").first
                link_elem = element.locator("a").first
                
                title = title_elem.inner_text() if title_elem.count() > 0 else "无标题"
                description = desc_elem.inner_text() if desc_elem.count() > 0 else "无描述"
                href = link_elem.get_attribute("href") if link_elem.count() > 0 else ""
                
                results.append({
                    "title": title.strip(),
                    "description": description.strip()[:200],
                    "url": href,
                    "index": i + 1
                })
            except:
                continue
                
    elif "xiaohongshu.com" in current_url:
        # 小红书搜索结果
        result_elements = page.locator(".note-item, .feed-item").all()
        for i, element in enumerate(result_elements[:10]):
            try:
                title_elem = element.locator(".title, .note-title").first
                desc_elem = element.locator(".desc, .note-text").first
                
                title = title_elem.inner_text() if title_elem.count() > 0 else "无标题"
                description = desc_elem.inner_text() if desc_elem.count() > 0 else "无描述"
                
                results.append({
                    "title": title.strip(),
                    "description": description.strip()[:200],
                    "index": i + 1,
                    "platform": "小红书"
                })
            except:
                continue
    
    # 如果没有找到特定的搜索结果，尝试通用选择器
    if not results:
        generic_results = page.locator("a").all()
        for i, element in enumerate(generic_results[:5]):
            try:
                text = element.inner_text().strip()
                href = element.get_attribute("href") or ""
                if text and len(text) > 5:
                    results.append({
                        "title": text[:100],
                        "url": href,
                        "index": i + 1,
                        "type": "通用链接"
                    })
            except:
                continue
    
    if results:
        result = {
            "success": True,
            "message": f"成功提取 {len(results)} 条搜索结果",
            "search_results": results,
            "content": results
        }
    else:
        result = {
            "success": False,
            "message": "未找到搜索结果",
            "search_results": [],
            "content": []
        }
        
except Exception as e:
    result = {
        "success": False,
        "message": "提取搜索结果时出错",
        "error": str(e)
    }