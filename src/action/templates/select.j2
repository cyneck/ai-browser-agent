# 在下拉菜单中选择选项
try:
    element = page.locator("{{ instruction.selector }}")
    element.select_option(value="{{ instruction.value }}")
    result = {
        "success": True,
        "message": "成功在 {{ instruction.selector }} 中选择选项 {{ instruction.value }}"
    }
except Exception as e:
    result = {
        "success": False,
        "message": "选择失败",
        "error": str(e)
    }