# 在输入框中输入文本 - Enhanced with visibility handling
try:
    # Enhanced selector strategy with fallbacks
    selector = "{{ instruction.selector }}"
    
    # Try multiple approaches for element interaction
    element = None
    
    # Approach 1: Direct selector
    try:
        element = page.locator(selector)
        # Check if element exists and is actionable
        element.wait_for(state="attached", timeout=3000)
        
        # Try to make element visible if hidden
        if not element.is_visible():
            # Scroll element into view
            element.scroll_into_view_if_needed()
            # Wait a bit for any animations
            page.wait_for_timeout(500)
            
            # If still not visible, try clicking on page body first
            if not element.is_visible():
                page.locator("body").click()
                page.wait_for_timeout(1000)
        
        # Attempt to fill the input
        element.fill("{{ instruction.value }}")
        
        result = {
            "success": True,
            "message": "成功在 {{ instruction.selector }} 中输入文本"
        }
        
    except Exception as direct_error:
        # Approach 2: Try alternative selectors if available
        alternative_selectors = [
            "input[name=wd]",  # Baidu search box alternative
            "input[type=search]",  # Generic search input
            ".search-input input",  # Common search input class
            "[placeholder*='搜索']",  # Chinese search placeholder
            "[placeholder*='search']",  # English search placeholder
        ]
        
        success = False
        for alt_selector in alternative_selectors:
            try:
                alt_element = page.locator(alt_selector)
                alt_element.wait_for(state="attached", timeout=2000)
                
                if alt_element.is_visible() or True:  # Try even if not visible
                    alt_element.scroll_into_view_if_needed()
                    alt_element.fill("{{ instruction.value }}")
                    
                    result = {
                        "success": True,
                        "message": f"成功使用备用选择器 {alt_selector} 输入文本"
                    }
                    success = True
                    break
                    
            except Exception:
                continue
        
        if not success:
            # Approach 3: Force interaction using JavaScript if needed
            try:
                # Use Jinja2 variables directly in JavaScript
                page.evaluate("""
                (function() {
                    const selector = '{{ instruction.selector }}';
                    const value = '{{ instruction.value }}';
                    const element = document.querySelector(selector);
                    if (element) {
                        element.style.display = 'block';
                        element.style.visibility = 'visible';
                        element.focus();
                        element.value = value;
                        const inputEvent = new Event('input', { bubbles: true });
                        const changeEvent = new Event('change', { bubbles: true });
                        element.dispatchEvent(inputEvent);
                        element.dispatchEvent(changeEvent);
                        return true;
                    }
                    return false;
                })();
                """)
                
                result = {
                    "success": True,
                    "message": "使用JavaScript强制输入成功"
                }
                
            except Exception as js_error:
                result = {
                    "success": False,
                    "message": "所有输入方法都失败了",
                    "error": f"Direct: {str(direct_error)[:100]}, JS: {str(js_error)[:100]}"
                }
                
except Exception as e:
    result = {
        "success": False,
        "message": "输入失败",
        "error": str(e)
    }