# 提取页面内容
try:
    {% if instruction.selector %}
    element = page.locator("{{ instruction.selector }}")
    content = element.inner_text()
    result = {
        "success": True,
        "message": "成功提取内容",
        "content": content
    }
    {% else %}
    content = page.content()
    result = {
        "success": True,
        "message": "成功提取页面内容",
        "content": content
    }
    {% endif %}
except Exception as e:
    result = {
        "success": False,
        "message": "提取内容失败",
        "error": str(e)
    }