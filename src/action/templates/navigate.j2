# 导航到指定URL
try:
    page.goto("{{ instruction.value }}", wait_until="domcontentloaded")
    result = {
        "success": True,
        "message": "成功导航到 {{ instruction.value }}"
    }
except Exception as e:
    result = {
        "success": False,
        "message": "导航失败",
        "error": str(e)
    }