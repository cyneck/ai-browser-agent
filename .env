# AI浏览器代理环境变量配置示例

# API密钥配置
OPENAI_API_KEY=your_openai_api_key_here

# 浏览器配置
BROWSER_TYPE=chromium  # 可选: chromium, firefox, webkit
HEADLESS=false  # 设置为true以隐藏浏览器界面

# 会话持久化配置
USER_DATA_DIR=./browser_data  # 浏览器会话数据存储路径

# 日志配置
LOG_LEVEL=INFO  # 可选: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/agent.log

# Web界面配置（如果使用）
WEB_HOST=127.0.0.1
WEB_PORT=8000

# 安全配置
ALLOWED_DOMAINS=jd.com,taobao.com,example.com  # 允许访问的域名列表，逗号分隔
MAX_EXECUTION_TIME=60  # 单个指令最大执行时间（秒）