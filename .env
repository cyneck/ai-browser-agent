# AI浏览器代理环境变量配置示例

# LLM配置
LLM_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# 其他配置保持默认或根据需要设置
BROWSER_TYPE=chromium
HEADLESS=false
LOG_LEVEL=INFO

# 浏览器配置
BROWSER_TYPE=chromium  # 可选: chromium, firefox, webkit
HEADLESS=false  # 设置为true以隐藏浏览器界面

# 会话持久化配置
USER_DATA_DIR=./browser_data  # 浏览器会话数据存储路径

# 日志配置
LOG_LEVEL=INFO  # 可选: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/agent.log

# Web界面配置（如果使用）
WEB_HOST=127.0.0.1
WEB_PORT=9000

# 执行超时配置
MAX_EXECUTION_TIME=60

# ============================================
# 人类行为模拟配置
# ============================================

# 启用/禁用人类行为模拟
HUMAN_BEHAVIOR_ENABLED=true

# 行为模式选择
# - conservative: 保守模式，较长延迟，适合敏感网站
# - moderate: 适中模式，平衡的延迟设置 (推荐)
# - aggressive: 激进模式，较短延迟，适合内部测试
HUMAN_BEHAVIOR_MODE=moderate

# ============================================
# 基础延迟配置 (秒)
# ============================================

# 每个操作的基础延迟范围
# conservative: 0.8-2.5, moderate: 0.3-1.2, aggressive: 0.1-0.6
HUMAN_BASE_DELAY_MIN=0.3
HUMAN_BASE_DELAY_MAX=1.2

# ============================================
# 操作间隔配置 (秒)
# ============================================

# 操作之间的间隔时间范围
# conservative: 1.5-5.0, moderate: 0.5-3.0, aggressive: 0.2-1.5
HUMAN_ACTION_INTERVAL_MIN=0.5
HUMAN_ACTION_INTERVAL_MAX=3.0

# ============================================
# 打字速度配置 (字符/秒)
# ============================================

# 模拟打字速度范围
# 3-5: 慢速打字, 5-8: 正常速度, 8-12: 快速打字
HUMAN_TYPING_SPEED_MIN=3
HUMAN_TYPING_SPEED_MAX=8

# ============================================
# 鼠标移动配置
# ============================================

# 启用鼠标移动模拟
HUMAN_MOUSE_MOVE_ENABLED=true

# ============================================
# 随机暂停配置
# ============================================

# 随机暂停的概率 (0.0-1.0)
# 0.1 = 10%概率, 0.15 = 15%概率, 0.25 = 25%概率
HUMAN_RANDOM_PAUSE_PROBABILITY=0.15

# 随机暂停的时长范围 (秒)
HUMAN_RANDOM_PAUSE_MIN=2.0
HUMAN_RANDOM_PAUSE_MAX=8.0

# ============================================
# 场景特定配置示例
# ============================================

# 场景1: 高安全性网站 (银行、支付等)
# HUMAN_BEHAVIOR_MODE=conservative
# HUMAN_BASE_DELAY_MIN=1.0
# HUMAN_BASE_DELAY_MAX=3.0
# HUMAN_ACTION_INTERVAL_MIN=2.0
# HUMAN_ACTION_INTERVAL_MAX=6.0
# HUMAN_RANDOM_PAUSE_PROBABILITY=0.3

# 场景2: 社交媒体网站
# HUMAN_BEHAVIOR_MODE=moderate
# HUMAN_BASE_DELAY_MIN=0.5
# HUMAN_BASE_DELAY_MAX=1.5
# HUMAN_ACTION_INTERVAL_MIN=1.0
# HUMAN_ACTION_INTERVAL_MAX=4.0
# HUMAN_RANDOM_PAUSE_PROBABILITY=0.2

# 场景3: 内部测试环境
# HUMAN_BEHAVIOR_MODE=aggressive
# HUMAN_BASE_DELAY_MIN=0.1
# HUMAN_BASE_DELAY_MAX=0.5
# HUMAN_ACTION_INTERVAL_MIN=0.2
# HUMAN_ACTION_INTERVAL_MAX=1.0
# HUMAN_RANDOM_PAUSE_PROBABILITY=0.05

# 场景4: 完全禁用 (最快速度)
# HUMAN_BEHAVIOR_ENABLED=false