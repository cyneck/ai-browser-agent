{
  "天气": {
    "patterns": [
      "(\\d+)°?[至~到-](\\d+)°?",
      "(\\d+)°?[C度]",
      "(晴|多云|阴|雨|雪|雾|霾)",
      "(微风|大风|台风|飓风)"
    ],
    "fields": ["最低温度", "最高温度", "天气状况", "风力"],
    "format": "{k}: {v}"
  },
  "价格": {
    "patterns": [
      "(\\d+(?:\\.\\d+)?)\\s*(?:元|￥|¥|$)",
      "(?:价格|售价|价钱)[：:\\s]*(\\d+(?:\\.\\d+)?)",
      "(\\d+(?:\\.\\d+)?)\\s*(?:美元|USD|usd)"
    ],
    "fields": ["价格"],
    "format": "{k}: {v}"
  },
  "股票": {
    "patterns": [
      "(\\d+(?:\\.\\d+)?)\\s*(?:点|股|元)",
      "(?:上涨|下跌|涨|跌)[了\\s]*(\\d+(?:\\.\\d+)?)%?",
      "当前(?:股价|价格)[：:\\s]*(\\d+(?:\\.\\d+)?)"
    ],
    "fields": ["股价", "涨跌幅"],
    "format": "{k}: {v}"
  },
  "时间": {
    "patterns": [
      "(\\d{1,2}):(\\d{2})",
      "(\\d{4})[年\\-/.](\\d{1,2})[月\\-/.](\\d{1,2})[日]?",
      "(?:今天|明天|后天|昨天|前天)"
    ],
    "fields": ["时间", "日期"],
    "format": "{k}: {v}"
  }
}